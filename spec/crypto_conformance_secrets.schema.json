{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/foxwhisper/crypto_conformance_secrets.schema.json",
  "title": "FoxWhisper Crypto Conformance Secrets (local-only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "encoding", "cases"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {"type": "string", "enum": ["base64"]}
      }
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/definitions/case"}
    }
  },
  "definitions": {
    "b64": {"type": "string", "minLength": 1},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "handshake"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "handshake": {"$ref": "#/definitions/handshake"}
      }
    },
    "handshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_x25519_private_key_b64", "client_kyber_private_key_b64"],
      "properties": {
        "client_x25519_private_key_b64": {"$ref": "#/definitions/b64"},
        "client_kyber_private_key_b64": {"$ref": "#/definitions/b64"}
      }
    }
  }
}
